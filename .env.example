# taleclaw 环境变量示例
#
# 使用时复制为 .env，然后只填写你需要启用的部分。
# 不要提交真实 .env。


# ---------------------------------------------------------------------------
# 1. 模型 Provider
# ---------------------------------------------------------------------------
# 推荐使用 OpenAI 兼容的自建 API 中转站。
# Base URL 通常写到 /v1，不要写到 /v1/chat/completions。

LLM_PROVIDER=openai_relay
OPENAI_RELAY_API_KEY=replace-me
OPENAI_RELAY_BASE_URL=https://your-relay.example.com/v1
OPENAI_RELAY_MODEL=gpt-4o-mini
OPENAI_RELAY_MAX_TOKENS_PARAM=max_tokens
# 中转站如果要求 wire_api = "responses"，这里设为 responses。
# 普通 /v1/chat/completions 兼容服务保持 chat_completions。
OPENAI_RELAY_WIRE_API=responses
# 模型总上下文窗口，不是输出 token 上限。可按实际模型填写。
OPENAI_RELAY_CONTEXT_WINDOW_TOKENS=128000
# 可选：如果 provider 文档单独给了输入/输出上限，可以填写。
OPENAI_RELAY_MAX_INPUT_TOKENS=
OPENAI_RELAY_MAX_OUTPUT_TOKENS=
# 预算管理给模型回复预留的输出 token。留空时会用保守默认值。
OPENAI_RELAY_OUTPUT_RESERVE_TOKENS=
# 可选：如果安装了 tiktoken，可指定 tokenizer model 做更准的 token 估算。
OPENAI_RELAY_TOKENIZER_MODEL=
# 默认关闭；只有显式打开时才会使用 BPE tokenizer。
OPENAI_RELAY_BPE_TOKENIZER_ENABLED=0

# 通用单 Provider 覆盖配置。除非你想临时覆盖当前 LLM_PROVIDER，
# 否则保持为空即可。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS_PARAM=
LLM_CONTEXT_WINDOW_TOKENS=
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_OUTPUT_RESERVE_TOKENS=
LLM_TOKENIZER_MODEL=
LLM_BPE_TOKENIZER_ENABLED=0

# 可选内置 Provider 配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MAX_TOKENS_PARAM=max_completion_tokens
MIMO_WIRE_API=chat_completions

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS_PARAM=max_tokens
GEMINI_WIRE_API=chat_completions

GLM47_API_KEY=
GLM47_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM47_MODEL=glm-4.7
GLM47_MAX_TOKENS_PARAM=max_tokens
GLM47_WIRE_API=chat_completions

# 可选：用 JSON 配置多个 Provider profile。
# 这里是当前 .env 使用的格式；api_key_env 指向上方对应的 key 变量名。
LLM_PROVIDERS_JSON={"openai_relay":{"api_key_env":"OPENAI_RELAY_API_KEY","base_url":"https://your-relay.example.com/v1","model":"gpt-4o-mini","wire_api":"responses","context_window_tokens":128000},"deepseek":{"api_key_env":"DEEPSEEK_API_KEY","base_url":"https://api.deepseek.com","model":"deepseek-v4-flash"},"mimo":{"api_key_env":"MIMO_API_KEY","base_url":"https://api.xiaomimimo.com/v1","model":"mimo-v2.5-pro","max_tokens_param":"max_completion_tokens"},"gemini":{"api_key_env":"GEMINI_API_KEY","base_url":"https://generativelanguage.googleapis.com/v1beta/openai/","model":"gemini-3.5-flash"},"glm47":{"api_key_env":"GLM47_API_KEY","base_url":"https://open.bigmodel.cn/api/paas/v4/","model":"glm-4.7","wire_api":"chat_completions"}}

# 填好 GEMINI_API_KEY 后，可以把 gemini 加入 LLM_ROUTE_*。


# ---------------------------------------------------------------------------
# 2. 模型路由
# ---------------------------------------------------------------------------
# 把不同类型的模型任务路由到不同 Provider。
# 如果只用一个中转站，可以全部指向 openai_relay。

LLM_ROUTE_DEFAULT=openai_relay,deepseek,mimo
LLM_ROUTE_CHAT=openai_relay,deepseek,mimo
LLM_ROUTE_CODING=openai_relay,deepseek,mimo
LLM_ROUTE_SUMMARY=openai_relay,deepseek,mimo
LLM_ROUTE_HYBRID=openai_relay,deepseek,mimo
LLM_ROUTE_TEAMMATE=openai_relay,deepseek,mimo
LLM_ROUTE_REFLECTION=openai_relay,deepseek,mimo
LLM_ROUTE_COMPACT=openai_relay,deepseek,mimo
LLM_ROUTE_SCHEDULED_AGENT=openai_relay,deepseek,mimo
LLM_ROUTE_SCHEDULER_PLAN=openai_relay,deepseek,mimo
LLM_ROUTE_SCHEDULER_ANALYZE=openai_relay,deepseek,mimo
LLM_ROUTE_TASK_CONCLUSION=openai_relay
LLM_ROUTE_FALLBACK=
LLM_ROUTE_SECURITY_ROUTER=openai_relay,deepseek,mimo
LLM_ROUTE_SECURITY_RAG=openai_relay,deepseek,mimo

# 兼容旧配置名。通常不需要设置；如果设置，会作为 default route 的候选来源。
LLM_DEFAULT_PROVIDER=

# Provider 健康检查与自动切换。
# 默认关闭，避免本地 import / 测试时自动请求外部模型服务。
# 开启后，启动时会检测指定 purpose 的 primary provider；
# 如果 primary 不通，会在 cooldown 窗口内优先切到 route 里的后备 provider。
LLM_HEALTHCHECK_ON_STARTUP=0
LLM_HEALTHCHECK_PURPOSES=chat,coding,summary,hybrid

# 运行中某个 provider 连续失败达到阈值后，会临时跳过它。
# 启动健康检查失败会立即进入 cooldown；普通运行失败按阈值累计。
LLM_PROVIDER_FAILURE_THRESHOLD=3
LLM_PROVIDER_FAILURE_COOLDOWN_SECONDS=300

# 可选：用 JSON 覆盖路由。
# LLM_ROUTES_JSON={"chat":"openai_relay,gemini,deepseek","coding":"openai_relay,gemini,deepseek","summary":"mimo,openai_relay","hybrid":"openai_relay","scheduler_analyze":"mimo,openai_relay"}


# ---------------------------------------------------------------------------
# 3. 运行时行为
# ---------------------------------------------------------------------------

USE_LOCAL_PROXY=0
LOCAL_PROXY_URL=http://127.0.0.1:7897

REFLECTION_ENABLED=0
REFLECTION_MAX_TOKENS=500
REFLECTION_MIN_REASONING_STEPS=10
REFLECTION_INTERVAL=5

# 主 reasoning loop 到达该步数比例后注入一次收尾提醒，避免信息足够后继续补充性取证。
REASONING_FINISHING_REMINDER_RATIO=0.7

# 工作记忆 checkpoint/resume：用户停止或步数耗尽后，可基于粗粒度线索续做。
WORKING_MEMORY_CHECKPOINT_ENABLED=1
WORKING_MEMORY_RESUME_ENABLED=1
WORKING_MEMORY_CONTEXT_BUDGET=4000
WORKING_MEMORY_CONTEXT_FLOOR=500

HYBRID_ROUTE_MODEL=
HYBRID_ROUTE_MAX_TOKENS=160

TASK_SANDBOX_TTL_HOURS=168
MARKDOWN_PDF_MAX_BYTES=2097152

# 短命 subagent 调度收敛控制。
SUBAGENT_MAX_REASONING_STEPS=12
SUBAGENT_MAX_FANOUTS_PER_RUN=4
SUBAGENT_MAX_FAILURES_PER_CLUE=2
SUBAGENT_MAX_SCOPE_FILES=5

# Coding task 可访问的真实 workspace 根目录 allowlist。
# 多个路径用系统 path separator 分隔：
# - Linux/macOS: /path/a:/path/b
# - Windows: C:\path\a;D:\path\b
# 未传 workspace_root 时，会 fallback 到 DEFAULT_CODING_WORKSPACE。
WORKSPACE_ROOTS=/home/tale/kaggle/mytry
DEFAULT_CODING_WORKSPACE=/home/tale/kaggle/mytry

# Context section budget 默认开启。coding 模式可启用下面的 CodingContextState，
# 让 working memory + active turn 先走总阈值结构化压缩，section budget 作为 fallback。
CONTEXT_ENABLE_SECTION_BUDGET=1
CONTEXT_BUDGET_CHARS=24000
CONTEXT_MODE_INSTRUCTIONS_BUDGET=3000
CONTEXT_PROJECT_INSTRUCTIONS_BUDGET=3000
CONTEXT_MEMORY_BUDGET=2000
CONTEXT_TASK_RUNTIME_EVENTS_BUDGET=1500
CONTEXT_MODE_INSTRUCTIONS_FLOOR=1000
CONTEXT_PROJECT_INSTRUCTIONS_FLOOR=1000
CONTEXT_MEMORY_FLOOR=500
CONTEXT_TASK_RUNTIME_EVENTS_FLOOR=300

# 对话历史预算。bot/assistant 模式会使用这个 section。
# coding 模式不渲染 conversation_history，会把这部分预算转给 active_turn。
CONTEXT_CONVERSATION_HISTORY_BUDGET=16000
CONTEXT_CONVERSATION_HISTORY_FLOOR=4000
CONTEXT_CONVERSATION_HISTORY_STRATEGY=summary_middle
CONTEXT_HISTORY_KEEP_HEAD_TURNS=3
CONTEXT_HISTORY_KEEP_TAIL_TURNS=6
CONTEXT_HISTORY_SUMMARY_MAX_CHARS=3000
CONTEXT_ACTIVE_TURN_BUDGET=8000
CONTEXT_ACTIVE_TURN_FLOOR=3000
CONTEXT_ACTIVE_TURN_STRATEGY=latest_tool_call
CONTEXT_ACTIVE_TURN_SUMMARY_MAX_CHARS=1800
CONTEXT_ACTIVE_TURN_KEEP_RECENT_RESULTS=5
CONTEXT_ACTIVE_TURN_PRESERVE_TOOLS=read_file,list_files,rg,git_diff,git_status,git_log,code_outline,repo_map

# Coding 模式结构化上下文状态。默认关闭；打开后，conversation history 仍丢弃，
# working memory 会同步进 coding_context_state，active turn 只保留最近完整消息组。
# 总 prompt 估算超过 trigger 后，旧消息组会被压缩进结构化 state。
CODING_CONTEXT_STATE_ENABLED=0
CODING_CONTEXT_COMPACTION_TRIGGER_TOKENS=12000
CODING_CONTEXT_COMPACTION_TARGET_TOKENS=8000
CODING_CONTEXT_RECENT_GROUPS=4

# 长工具结果原文存储。压缩后的上下文会带 tool_result://... 引用；
# 需要精确原文时，agent 可以调用 retrieve_tool_result 分页取回。
# 默认 file 写到 .tool_results/；部署环境可改 postgres 并复用 DATABASE_URL。
TOOL_RESULT_STORE_BACKEND=file
TOOL_RESULT_STORE_ROOT=.tool_results
TOOL_RESULT_DATABASE_URL=

# 如果你想更激进地控制上下文，可以使用下面这组示例：
# CONTEXT_ENABLE_SECTION_BUDGET=1
# CONTEXT_BUDGET_CHARS=16000
# CONTEXT_CONVERSATION_HISTORY_BUDGET=8000
# CONTEXT_CONVERSATION_HISTORY_STRATEGY=summary_middle
# CONTEXT_HISTORY_KEEP_HEAD_TURNS=2
# CONTEXT_HISTORY_KEEP_TAIL_TURNS=4
# CONTEXT_HISTORY_SUMMARY_MAX_CHARS=1800


# ---------------------------------------------------------------------------
# 4. Web 控制台
# ---------------------------------------------------------------------------

WEB_USERNAME=agent
WEB_PASSWORD=replace-with-a-strong-password

# 多用户部署时建议使用 WEB_USERS_JSON，并删除 WEB_USERNAME /
# WEB_PASSWORD，避免配置含义混乱。
# WEB_USERS_JSON={"admin":{"password":"change-admin","role":"admin"},"guest":{"password":"change-guest","role":"user"}}

WEB_ALLOW_REGISTRATION=0
WEB_ALLOW_ANONYMOUS=0
WEB_SESSION_TTL_HOURS=168
WEB_COOKIE_SECURE=0
WEB_MAX_BODY_BYTES=52428800
# Eager 初始化 RAG / Postgres / 模型客户端时，runtime 启动可能超过 15 秒。
AGENT_RUNTIME_STARTUP_TIMEOUT_SECONDS=15
# Web 请求等待 agent 回复的超时；应大于一次长 coding turn 的预期耗时。
WEB_AGENT_REPLY_TIMEOUT_SECONDS=180
# 正文流式输出完成后，自动生成会话标题的最长等待时间；超时使用首问题兜底。
WEB_SESSION_TITLE_TIMEOUT_SECONDS=8


# ---------------------------------------------------------------------------
# 5. Scheduler 与插件
# ---------------------------------------------------------------------------

TAVILY_API_KEY=replace-me

SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_RECONCILE_SECONDS=30
SCHEDULER_ANALYSIS_MODEL=
SCHEDULER_ANALYSIS_MAX_TOKENS=1800
SCHEDULER_PLANNER_MODEL=
SCHEDULER_PLANNER_MAX_TOKENS=1000


# ---------------------------------------------------------------------------
# 6. Python 与 Docker 构建
# ---------------------------------------------------------------------------

PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_DEFAULT_TIMEOUT=180
PIP_RETRIES=10

# Docker 构建默认使用轻量部署依赖，不安装 RAG 大模型依赖。
REQUIREMENTS_FILE=requirements-deploy.txt
INSTALL_RAG_DEPS=0
# Docker Hub 访问超时时，可以临时改成云厂商镜像源。
# 腾讯云示例：
# PYTHON_IMAGE=mirror.ccs.tencentyun.com/library/python:3.12-slim
# POSTGRES_IMAGE=mirror.ccs.tencentyun.com/library/postgres:16
# QDRANT_IMAGE=mirror.ccs.tencentyun.com/qdrant/qdrant:latest
POSTGRES_IMAGE=postgres:16
QDRANT_IMAGE=qdrant/qdrant:latest


# ---------------------------------------------------------------------------
# 7. Telegram 网关
# ---------------------------------------------------------------------------
# 默认不启用。只有启动 telegram_worker 且配置 TELEGRAM_BOT_TOKEN 后才会工作。
# 详见 docs/gateways/TELEGRAM_GATEWAY.md。

TELEGRAM_BOT_TOKEN=

# 逗号分隔的 Telegram user ID。使用 * 表示允许任意 Telegram 用户
# 作为普通隔离账号接入。
TELEGRAM_ALLOWED_USER_IDS=

# 显式映射可以把 Telegram 用户绑定到已有 user_id，或授予 admin 角色。
# TELEGRAM_USER_MAP={"123456789":{"user_id":"admin","role":"admin"}}
TELEGRAM_USER_MAP=

TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_RETRY_DELAY=3
TELEGRAM_PROXY_URL=

TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_NOTIFY_MAX_CHARS=3500
TELEGRAM_NOTIFY_SEND_REPORT_FILE=1
TELEGRAM_NOTIFY_DOCUMENT_MAX_BYTES=10485760

TELEGRAM_OUTBOX_BATCH_SIZE=10
TELEGRAM_OUTBOX_MAX_ATTEMPTS=3
TELEGRAM_STORAGE_PREVIEW_BYTES=8000
TELEGRAM_STORAGE_DOWNLOAD_MAX_BYTES=10485760


# ---------------------------------------------------------------------------
# 8. 飞书网关
# ---------------------------------------------------------------------------
# 默认不启用。只有启动 feishu_worker 且配置飞书应用凭据后才会工作。
# 详见 docs/gateways/FEISHU_GATEWAY.md。

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn

FEISHU_CALLBACK_HOST=0.0.0.0
FEISHU_CALLBACK_PORT=8010
FEISHU_CALLBACK_PATH=/feishu/events
FEISHU_CALLBACK_MAX_BYTES=1048576
FEISHU_CALLBACK_ACK_TIMEOUT=5

# 逗号分隔的飞书 open_id。使用 * 表示允许任意飞书用户
# 作为普通隔离账号接入。
FEISHU_ALLOWED_OPEN_IDS=

# 显式映射可以把飞书用户绑定到已有 user_id，或授予 admin 角色。
# FEISHU_USER_MAP={"ou_xxx":{"user_id":"admin","role":"admin"}}
FEISHU_USER_MAP=

# 群聊默认只有 @ 机器人时才响应。设为 1 后，群里所有文本都会触发响应。
FEISHU_RESPOND_IN_GROUPS=0
FEISHU_BOT_OPEN_ID=
FEISHU_PROXY_URL=

FEISHU_NOTIFY_CHAT_IDS=
FEISHU_NOTIFY_MAX_CHARS=3500
FEISHU_NOTIFY_SEND_REPORT_FILE=1
FEISHU_NOTIFY_DOCUMENT_MAX_BYTES=10485760

FEISHU_OUTBOX_BATCH_SIZE=10
FEISHU_OUTBOX_MAX_ATTEMPTS=3
FEISHU_OUTBOX_POLL_SECONDS=2
FEISHU_STORAGE_PREVIEW_BYTES=8000
FEISHU_STORAGE_DOWNLOAD_MAX_BYTES=10485760


# ---------------------------------------------------------------------------
# 9. 向量历史会话 / Qdrant / 安全 RAG
# ---------------------------------------------------------------------------
# 部署默认关闭 RAG/向量检索，减少镜像体积、启动时间和 Qdrant 运维成本。
# 需要启用历史向量或代码安全 RAG 时，将 RAG_ENABLED 改为 1，并按下方说明启动 qdrant。
#
# 启动 Qdrant:
#   INSTALL_RAG_DEPS=1 RAG_ENABLED=1 docker compose --profile rag up -d --build qdrant agent-console
# Web UI:
#   http://127.0.0.1:6333/dashboard

RAG_ENABLED=0
HISTORY_VECTOR_ENABLED=0
HISTORY_VECTOR_STRICT=0
HISTORY_VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=taleclaw_history
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=Cosine

# Governed long-term semantic memory. Enable the write/read/context flags in
# order during migration; PostgreSQL remains the truth source in every mode.
SEMANTIC_MEMORY_ENABLED=0
SEMANTIC_MEMORY_WRITE_ENABLED=0
SEMANTIC_MEMORY_READ_ENABLED=0
SEMANTIC_MEMORY_CONTEXT_ENABLED=0
SEMANTIC_MEMORY_INDEX_ENABLED=1
SEMANTIC_MEMORY_INDEX_STRICT=0
SEMANTIC_MEMORY_QDRANT_COLLECTION=taleclaw_semantic_memory_v1
SEMANTIC_MEMORY_RETRIEVAL_TOP_K=8
MEMORY_LEGACY_HISTORY_FILES_ENABLED=0
MEMORY_GOVERNANCE_ENABLED=0
CONTEXT_PRESSURE_OBSERVATION_ENABLED=0
CONTEXT_PRESSURE_WINDOW_TOKENS=128000
MEMORY_PENDING_ENRICHMENT_ENABLED=0
MEMORY_INJECTION_TRACE_ENABLED=0
CONTEXT_SEMANTIC_MEMORY_BUDGET=2000
CONTEXT_SEMANTIC_MEMORY_FLOOR=500
CONTEXT_EPISODIC_HISTORY_BUDGET=2500
CONTEXT_EPISODIC_HISTORY_FLOOR=500

# 推荐先用 hash 做本地烟测，不下载模型；正式使用再切 fastembed 或 bge_m3。
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=

# 每轮构造上下文时，从向量库召回多少条历史 turn，以及最低相似度。
HISTORY_RETRIEVAL_TOP_K=6
HISTORY_RETRIEVAL_MIN_SCORE=0.35
CONTEXT_RETRIEVED_HISTORY_BUDGET=2500
CONTEXT_RETRIEVED_HISTORY_FLOOR=500
CONTEXT_SECURITY_KNOWLEDGE_BUDGET=3000
CONTEXT_SECURITY_KNOWLEDGE_FLOOR=800

# 候选记忆选择器：只在当前用户描述能从历史向量库召回多个相似 turn 时，
# 才放入 PENDING.json。候选多次触发后，再由 LLM 提炼稳定记忆写入 MEMORY.md。
MEMORY_CANDIDATE_SIMILAR_TOP_K=8
MEMORY_CANDIDATE_SIMILAR_MIN_SCORE=0.55
MEMORY_CANDIDATE_SIMILAR_MIN_HITS=2
MEMORY_CANDIDATE_PROMOTION_CONFIDENCE=0.85
MEMORY_CANDIDATE_PROMOTION_EVIDENCE_COUNT=3
MEMORY_CANDIDATE_EXTRACT_MAX_TOKENS=220
MEMORY_CANDIDATE_KEYWORDS=

# 代码安全 RAG 知识库。它和“历史会话向量库”是两套 collection。
SECURITY_RAG_SOURCE_ROOT=/home/tale/kaggle/code-security-kb
SECURITY_RAG_COLLECTION=code_security_kb_bge_m3
SECURITY_RAG_QDRANT_URL=http://127.0.0.1:6333
SECURITY_RAG_QDRANT_API_KEY=
SECURITY_RAG_EMBEDDING_PROVIDER=bge_m3
# 可以填远程模型 ID，也可以填本地已下载模型目录。
# 例如：/home/tale/kaggle/mytry/models/bge-m3
SECURITY_RAG_EMBEDDING_MODEL=BAAI/bge-m3
SECURITY_RAG_EMBEDDING_DEVICE=
SECURITY_RAG_VECTOR_SIZE=1024
SECURITY_RAG_DISTANCE=Cosine
SECURITY_RAG_AUTO_CONTEXT_ENABLED=0
SECURITY_RAG_PLUGIN_ENABLED=0
SECURITY_RAG_EMBEDDING_USE_FP16=1
SECURITY_RAG_EMBEDDING_MAX_LENGTH=8192
SECURITY_RAG_CHUNKING_VERSION=2

# 开启后新建 collection 会使用 dense+sparse 双向量，并用 Qdrant RRF 融合检索。
SECURITY_RAG_HYBRID_ENABLED=0
SECURITY_RAG_SPARSE_EMBEDDING_PROVIDER=
SECURITY_RAG_SPARSE_EMBEDDING_MODEL=
SECURITY_RAG_SPARSE_HASH_SIZE=1048576
SECURITY_RAG_RERANKER_ENABLED=0
SECURITY_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SECURITY_RAG_RERANKER_USE_FP16=1
SECURITY_RAG_RERANKER_CANDIDATES=12
SECURITY_RAG_RERANKER_MAX_CHARS=1200
SECURITY_RAG_TRACE_ENABLED=1
SECURITY_RAG_TRACE_DIR=~/.claude/rag_traces
SECURITY_RAG_CACHE_ENABLED=1
SECURITY_RAG_CACHE_MAX_SIZE=512
SECURITY_RAG_CACHE_TTL_SECONDS=3600
SECURITY_RAG_EMBEDDING_CACHE_ENABLED=1
SECURITY_RAG_EMBEDDING_CACHE_MAX_SIZE=2048
SECURITY_RAG_EMBEDDING_CACHE_TTL_SECONDS=3600
SECURITY_RAG_INCREMENTAL_STATE=~/.claude/rag_ingest_state.json
SECURITY_RAG_AB_ENABLED=0
SECURITY_RAG_AB_SPLIT_RATIO=0.5

# 安全 RAG 触发路由：
# 1. keyword 命中：直接查。
# 2. keyword 未命中：用 embedding 和安全意图样例算相似度。
# 3. 分数 >= high：直接查；分数 <= low：不查；中间段可交给 LLM 分类。
SECURITY_RAG_ROUTE_HIGH_THRESHOLD=0.72
SECURITY_RAG_ROUTE_LOW_THRESHOLD=0.45
SECURITY_RAG_ROUTE_LLM_ACCEPT_THRESHOLD=0.60
SECURITY_RAG_ROUTE_LLM_ENABLED=0
SECURITY_RAG_ROUTE_LLM_PURPOSE=summary
SECURITY_RAG_ROUTE_LLM_MAX_TOKENS=350
SECURITY_RAG_ROUTE_TOP_K=5
SECURITY_RAG_ROUTE_MIN_SCORE=0.0
SECURITY_RAG_ROUTE_PRE_DENSE_REWRITE_ENABLED=0
SECURITY_RAG_PRE_DENSE_REWRITE_PROVIDER=rule
SECURITY_RAG_REWRITE_LLM_ENABLED=0
SECURITY_RAG_REWRITE_LLM_PURPOSE=security_router
SECURITY_RAG_REWRITE_LLM_MAX_TOKENS=256
SECURITY_RAG_REWRITE_LLM_MAX_QUERIES=2
SECURITY_RAG_REWRITE_CACHE_MAX_SIZE=512
SECURITY_RAG_REWRITE_CACHE_TTL_SECONDS=3600
SECURITY_RAG_DECOMPOSE_PARALLEL_ENABLED=1
SECURITY_RAG_DECOMPOSE_PARALLEL_WORKERS=4
SECURITY_RAG_PRE_DENSE_PARALLEL_ENABLED=1


# ---------------------------------------------------------------------------
# 10. PostgreSQL
# ---------------------------------------------------------------------------
# 系统只支持 PostgreSQL。DATABASE_URL 是最低必填项；如果某个子系统需要
# 独立库或独立 schema，可以设置对应的 *_DATABASE_URL 覆盖。
#
# Docker Compose 内部访问使用 postgres:5432。
# 宿主机调试连接使用 127.0.0.1:${POSTGRES_HOST_PORT}。

POSTGRES_DB=agent_console
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
POSTGRES_HOST_PORT=55432
# Docker Compose 部署推荐：
# DATABASE_URL=postgresql://agent:agent_dev_password@postgres:5432/agent_console
# 本机直接运行时可用：
# DATABASE_URL=postgresql://agent:agent_dev_password@127.0.0.1:55432/agent_console
DATABASE_URL=
SESSION_DATABASE_URL=
WEB_AUTH_DATABASE_URL=
MEMORY_ARCHIVE_DATABASE_URL=
GATEWAY_DATABASE_URL=
TELEGRAM_DATABASE_URL=
FEISHU_DATABASE_URL=

# Trace 原始 JSONL 仍然写本地文件；这里控制 run 索引和执行路径摘要表。
# 不配置 TRACE_DATABASE_URL 时会复用 DATABASE_URL。
TRACE_INDEX_ENABLED=1
TRACE_DATABASE_URL=


# ---------------------------------------------------------------------------
# 11. HuggingFace 下载
# ---------------------------------------------------------------------------
# BAAI/bge-m3 等大模型首次下载会比较慢。安装 hf_transfer 后开启此项，
# huggingface_hub 会使用更快的传输后端。
HF_ENDPOINT=https://huggingface.co
HF_HUB_ENABLE_HF_TRANSFER=1
HF_HUB_DOWNLOAD_TIMEOUT=600
HF_HUB_ETAG_TIMEOUT=60
# 如果模型已经下载到本地，并且 SECURITY_RAG_EMBEDDING_MODEL 等配置都指向本地路径，
# 可以开启离线模式，避免 agent 启动时访问 HuggingFace。
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0
