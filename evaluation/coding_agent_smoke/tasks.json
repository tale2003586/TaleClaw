      "id": "S09",
      "title": "Rename module and update import",
      "category": "rename",
      "prompt": "Rename src/helo.py to src/hello.py and update imports so the unittest suite still passes.",
      "files": {
        "src/helo.py": [
          "def greet(name):",
          "    return f'Hello, {name}!'"
        ],
        "src/main.py": [
          "from helo import greet",
          "",
          "",
          "def render(name):",
          "    return greet(name)"
        ],
        "tests/test_main.py": [
          "import pathlib",
          "import sys",
          "import unittest",
          "sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / 'src'))",
          "",
          "from main import render",
          "",
          "",
          "class MainTests(unittest.TestCase):",
          "    def test_render(self):",
          "        self.assertEqual(render('Ada'), 'Hello, Ada!')"
