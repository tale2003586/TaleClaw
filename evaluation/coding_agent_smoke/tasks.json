    {
      "id": "S12",
      "title": "Add required Python type hints",
      "category": "typecheck",
      "prompt": "Add type hints to src/user.py so scripts/typecheck.py passes. Do not change runtime behavior.",
      "files": {
        "src/user.py": [
          "def format_user(user):",
          "    return f\"{user['name']} <{user['email']}>\""
        ],
        "scripts/typecheck.py": [
          "import ast",
          "from pathlib import Path",
          "",
          "tree = ast.parse(Path('src/user.py').read_text())",
          "func = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'format_user')",
          "assert func.returns is not None, 'format_user needs a return annotation'",
          "assert func.args.args[0].annotation is not None, 'format_user argument needs an annotation'",
          "print('typecheck ok')"
        ],
        "tests/test_user.py": [
          "import pathlib",
          "import sys",
          "import unittest",
          "sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / 'src'))",
          "",
          "from user import format_user",
          "",
          "",
          "class UserTests(unittest.TestCase):",
          "    def test_format_user(self):",
          "        self.assertEqual(format_user({'name': 'Ada', 'email': 'ada@example.com'}), 'Ada <ada@example.com>')"
        ]
      },
      "validation_commands": [
        "python scripts/typecheck.py",
        "python -m unittest discover -s tests -q"
      ],
      "checks": [
        {
          "type": "only_changed",
          "paths": [
            "src/user.py"
          ]
        }
      ]
    },
