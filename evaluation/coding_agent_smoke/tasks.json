{
  "version": 1,
  "name": "coding-agent-runtime-smoke-set",
  "description": "Thirty small local tasks for checking whether a coding-agent runtime can read, edit, run commands, preserve dirty work, and produce verifiable patches.",
  "tasks": [
    {
      "id": "S01",
      "title": "Read README metadata",
      "category": "read-file",
      "prompt": "Read README.md and write answer.txt with exactly two lines: Project: <project name> and Version: <version>.",
      "files": {
        "README.md": [
          "# Ember Runtime",
          "",
          "Version: 0.3.7",
          "",
          "A tiny fixture for a local coding-agent smoke test."
        ]
      },
      "checks": [
        {
          "type": "file_equals",
          "path": "answer.txt",
          "text": [
            "Project: Ember Runtime",
            "Version: 0.3.7"
          ]
        },
        {
          "type": "only_changed",
          "paths": [
            "answer.txt"
          ]
        }
      ]
    },
    {
      "id": "S02",
      "title": "List Python files under src",
      "category": "list-files",
      "prompt": "List every .py file under src/, sorted alphabetically, one path per line, and write the result to py-files.txt. Do not include files outside src/.",
      "files": {
        "src/app.py": [
          "def main():",
          "    return 'ok'"
        ],
        "src/utils/helpers.py": [
          "VALUE = 1"
        ],
        "src/utils/parser.py": [
          "def parse(value):",
          "    return value.strip()"
        ],
        "tests/test_app.py": [
          "import unittest",
          "",
          "",
          "class AppTests(unittest.TestCase):",
          "    def test_placeholder(self):",
          "        self.assertTrue(True)"
        ],
        "docs/example.py": [
          "# This file must not be listed."
        ]
      },
      "checks": [
        {
          "type": "file_equals",
          "path": "py-files.txt",
          "text": [
            "src/app.py",
            "src/utils/helpers.py",
            "src/utils/parser.py"
          ]
        },
        {
          "type": "only_changed",
          "paths": [
            "py-files.txt"
          ]
        }
      ]
    },
    {
      "id": "S03",
      "title": "Search TODO locations",
      "category": "search",
      "prompt": "Find every TODO(smoke) marker and write todo-locations.txt with path:line entries sorted alphabetically by path. Ignore TODO markers that are not TODO(smoke).",
      "files": {
        "src/a.py": [
          "def start():",
          "    pass",
          "# TODO(smoke): wire start"
        ],
        "docs/plan.md": [
          "# Plan",
          "",
          "- TODO(smoke): document setup"
        ],
        "src/nested/b.py": [
          "# TODO(other): no",
          "def run():",
          "    # TODO(smoke): validate input",
          "    return True"
        ]
      },
      "checks": [
        {
          "type": "file_equals",
          "path": "todo-locations.txt",
          "text": [
            "docs/plan.md:3",
            "src/a.py:3",
            "src/nested/b.py:3"
          ]
        },
        {
          "type": "only_changed",
          "paths": [
            "todo-locations.txt"
          ]
        }
      ]
    },
    {
